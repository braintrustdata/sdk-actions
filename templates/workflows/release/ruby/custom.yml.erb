<%#
params:
  gem_name:            { required: true,  desc: "RubyGems gem name (also the release label)" }
  version_module:      { required: true,  desc: "Ruby module exposing VERSION, e.g. Braintrust" }
  version_file:        { default: "",     desc: "Path to version.rb (default: derived from version_module)" }
  working_directory:   { default: ".",    desc: "Gem root, relative to the repo root" }
  ruby_version:        { default: "",     desc: "Ruby version or version-file path (default: the action's default)" }
  workflow_name:       { default: "Release", desc: "Workflow display name" }
  emoji:               { default: ":gem:", desc: "Slack notification emoji" }
  publish_environment: { default: "publish",          desc: "Environment gating the real publish" }
  dry_run_environment: { default: "publish-dry-run",  desc: "Environment gating dry runs" }
  slack_token_secret:  { default: "SLACK_BOT_TOKEN",           desc: "Secret holding the Slack bot token" }
  slack_channel_var:   { default: "SLACK_SDK_RELEASE_CHANNEL", desc: "Variable holding the Slack channel ID" }
checklist:
  - "Create GitHub Environments '%{publish_environment}' (add required reviewers) and '%{dry_run_environment}'."
  - "Add a RubyGems trusted publisher for %{gem_name}: repo=<owner/repo>, workflow=%{workflow_file}, environment=%{publish_environment}."
  - "(optional) Set repo secret %{slack_token_secret} and variable %{slack_channel_var} to enable Slack notifications."
  - "Confirm %{version_module}::VERSION is committed before dispatching — the release runs against that commit."
-%>
<%-
  ref                 = locals.fetch(:ref)
  gem_name            = locals.fetch(:gem_name)
  version_module      = locals.fetch(:version_module)
  working_directory   = locals.fetch(:working_directory)
  ruby_version        = locals.fetch(:ruby_version)
  workflow_name       = locals.fetch(:workflow_name)
  emoji               = locals.fetch(:emoji)
  publish_environment = locals.fetch(:publish_environment)
  dry_run_environment = locals.fetch(:dry_run_environment)
  slack_token_secret  = locals.fetch(:slack_token_secret)
  slack_channel_var   = locals.fetch(:slack_channel_var)
  version_file = locals.fetch(:version_file)
  version_file = "lib/#{version_module.split('::').map { |p| p.gsub(/([a-z0-9])([A-Z])/, '\1_\2').downcase }.join('/')}/version.rb" if version_file.to_s.empty?
-%>
name: <%= workflow_name %>

# Releases <%= gem_name %> to RubyGems via braintrustdata/sdk-actions, custom-build shape:
# an unprivileged `pack` job builds + attests the gem (no publish creds) and uploads it;
# a gated `ship-package` job verifies the attestation and publishes THAT exact gem.
# Dispatch after merging the commit that bumps <%= version_module %>::VERSION.
on:
  workflow_dispatch:
    inputs:
      release_type:
        description: "Release type (stable → GitHub release; prerelease → none)"
        type: choice
        default: stable
        options: [stable, prerelease]
      sha:
        description: "Commit SHA (of the version bump) to release"
        required: true
        type: string
      prev_release:
        description: "Release-notes anchor: a tag or SHA (empty → the previous tag)"
        type: string
        required: false
      dry_run:
        description: "Dry run: build + pack without attesting or publishing"
        type: boolean
        default: false

jobs:
  # FACT-FIND — derive version/tag/notes, check the registry, and emit the package manifest.
  # contents: write is for the releases/generate-notes API.
  configure:
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    permissions:
      contents: write
    outputs:
      version: ${{ steps.configure.outputs.version }}
      release_tag: ${{ steps.configure.outputs.release_tag }}
      prev_release: ${{ steps.configure.outputs.prev_release }}
      branch: ${{ steps.configure.outputs.branch }}
      on_release_branch: ${{ steps.configure.outputs.on_release_branch }}
      commit_message: ${{ steps.configure.outputs.commit_message }}
      github_release: ${{ steps.configure.outputs.github_release }}
      already_published: ${{ steps.configure.outputs.already_published }}
      notes: ${{ steps.configure.outputs.notes }}
      package: ${{ steps.configure.outputs.package }}
    steps:
      - name: Configure release
        id: configure
        uses: braintrustdata/sdk-actions/actions/release/lang/ruby/configure@<%= ref %>
        with:
          version_file: <%= version_file %>
          version_module: <%= version_module %>
          sha: ${{ inputs.sha }}
          working_directory: <%= working_directory %>
          release_type: ${{ inputs.release_type }}
          rubygems_package_name: <%= gem_name %>
          package_label: <%= gem_name %>
          emoji: '<%= emoji %>'
          prev_release: ${{ inputs.prev_release }}

  validate:
    needs: [configure]
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    permissions:
      contents: read
    steps:
      - name: Validate release
        uses: braintrustdata/sdk-actions/actions/release/lang/ruby/validate@<%= ref %>
        with:
          sha: ${{ inputs.sha }}
          dry_run: ${{ inputs.dry_run }}
          working_directory: <%= working_directory %>
          release_tag: ${{ needs.configure.outputs.release_tag }}
          on_release_branch: ${{ needs.configure.outputs.on_release_branch }}
          notes: ${{ needs.configure.outputs.notes }}
          already_published: ${{ needs.configure.outputs.already_published }}
<%- unless ruby_version.to_s.empty? -%>
          ruby_version: <%= ruby_version %>
<%- end -%>
          build: 'false'   # the pack job owns the build (lint still runs)
          sbom: 'false'    # the pack job generates + attests the SBOM

  # BUILD side — unprivileged: builds + attests the gem, NO publish credentials.
  pack:
    needs: [configure, validate]
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    permissions:
      contents: read
      id-token: write
      attestations: write
    steps:
      - name: Pack + attest
        uses: braintrustdata/sdk-actions/actions/release/lang/ruby/pack@<%= ref %>
        with:
          sha: ${{ inputs.sha }}
          working_directory: <%= working_directory %>
<%- unless ruby_version.to_s.empty? -%>
          ruby_version: <%= ruby_version %>
<%- end -%>
          dry_run: ${{ inputs.dry_run }}

      - name: Stage artifact
        run: |
          mkdir -p artifact
          cp <%= working_directory %>/pkg/*.gem artifact/
          cp <%= working_directory %>/sbom.json artifact/ 2>/dev/null || true

      - name: Upload artifact
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: release-package
          path: artifact/
          retention-days: 1
          if-no-files-found: error

  request-approval:
    needs: [configure, validate, pack]
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    permissions: {}
    steps:
      - name: Request release approval
        uses: braintrustdata/sdk-actions/actions/release/request-approval@<%= ref %>
        with:
          packages: '{"packages":[${{ needs.configure.outputs.package }}]}'
          sha: ${{ inputs.sha }}
          branch: ${{ needs.configure.outputs.branch }}
          on_release_branch: ${{ needs.configure.outputs.on_release_branch }}
          commit_message: ${{ needs.configure.outputs.commit_message }}
          dry_run: ${{ inputs.dry_run }}
          slack_token: ${{ secrets.<%= slack_token_secret %> }}
          slack_channel: ${{ vars.<%= slack_channel_var %> }}

  # PUBLISH side — gated: verifies the attestation against the downloaded gem, then publishes it.
  ship-package:
    needs: [configure, validate, pack, request-approval]
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    environment: ${{ inputs.dry_run && '<%= dry_run_environment %>' || '<%= publish_environment %>' }}
    permissions:
      contents: write
      id-token: write     # OIDC trusted publishing
      attestations: read  # gh attestation verify
    steps:
      - name: Download artifact
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: release-package
          path: dl

      - name: Ship package
        uses: braintrustdata/sdk-actions/actions/release/lang/ruby/ship-package@<%= ref %>
        with:
          working_directory: dl   # holds the .gem + sbom.json
          sha: ${{ inputs.sha }}
          dry_run: ${{ inputs.dry_run }}
          release_tag: ${{ needs.configure.outputs.release_tag }}
          already_published: ${{ needs.configure.outputs.already_published }}
          github_release: ${{ needs.configure.outputs.github_release }}
          gem_name: <%= gem_name %>
          version: ${{ needs.configure.outputs.version }}
          label: <%= gem_name %>
          notes: ${{ needs.configure.outputs.notes }}
          prev_release: ${{ needs.configure.outputs.prev_release }}
          branch: ${{ needs.configure.outputs.branch }}
          on_release_branch: ${{ needs.configure.outputs.on_release_branch }}
          slack_token: ${{ secrets.<%= slack_token_secret %> }}
          slack_channel: ${{ vars.<%= slack_channel_var %> }}
          emoji: '<%= emoji %>'
