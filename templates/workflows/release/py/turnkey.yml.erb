<%#
params:
  package_name:        { required: true,  desc: "PyPI package name (also the release label)" }
  version_file:        { default: "",     desc: "Python module exposing VERSION (default: src/<package>/version.py)" }
  python_version:      { default: ".python-version", desc: "Python version, or a path to a version file" }
  working_directory:   { default: ".",    desc: "Project root, relative to the repo root" }
  workflow_name:       { default: "Release", desc: "Workflow display name" }
  emoji:               { default: ":python:", desc: "Slack notification emoji" }
  publish_environment: { default: "publish",          desc: "Environment gating the real publish" }
  dry_run_environment: { default: "publish-dry-run",  desc: "Environment gating dry runs" }
  slack_token_secret:  { default: "SLACK_BOT_TOKEN",           desc: "Secret holding the Slack bot token" }
  slack_channel_var:   { default: "SLACK_SDK_RELEASE_CHANNEL", desc: "Variable holding the Slack channel ID" }
checklist:
  - "Create GitHub Environments '%{publish_environment}' (add required reviewers) and '%{dry_run_environment}'."
  - "Add a PyPI trusted publisher for %{package_name}: repo=<owner/repo>, workflow=%{workflow_file}, environment=%{publish_environment}."
  - "(optional) Set repo secret %{slack_token_secret} and variable %{slack_channel_var} to enable Slack notifications."
  - "Confirm your version file defines VERSION and is committed before dispatching — the release runs against that commit."
-%>
<%-
  ref                 = locals.fetch(:ref)
  package_name        = locals.fetch(:package_name)
  python_version      = locals.fetch(:python_version)
  working_directory   = locals.fetch(:working_directory)
  workflow_name       = locals.fetch(:workflow_name)
  emoji               = locals.fetch(:emoji)
  publish_environment = locals.fetch(:publish_environment)
  dry_run_environment = locals.fetch(:dry_run_environment)
  slack_token_secret  = locals.fetch(:slack_token_secret)
  slack_channel_var   = locals.fetch(:slack_channel_var)
  # version_file defaults to src/<import-name>/version.py (PyPI name's hyphens -> underscores)
  version_file = locals.fetch(:version_file)
  version_file = "src/#{package_name.tr('-', '_')}/version.py" if version_file.to_s.empty?
-%>
name: <%= workflow_name %>

# Releases <%= package_name %> to PyPI via braintrustdata/sdk-actions. Dispatch after merging
# the commit that bumps VERSION in <%= version_file %>; the release runs against that commit's SHA.
on:
  workflow_dispatch:
    inputs:
      release_type:
        description: "Release type (stable → GitHub release; prerelease → none)"
        type: choice
        default: stable
        options: [stable, prerelease]
      sha:
        description: "Commit SHA (of the version bump) to release"
        required: true
        type: string
      prev_release:
        description: "Release-notes anchor: a tag or SHA (empty → the previous tag)"
        type: string
        required: false
      dry_run:
        description: "Dry run: build without tagging or publishing"
        type: boolean
        default: false

jobs:
  configure:
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    permissions:
      contents: read
    outputs:
      version: ${{ steps.configure.outputs.version }}
      release_tag: ${{ steps.configure.outputs.release_tag }}
      prev_release: ${{ steps.configure.outputs.prev_release }}
      branch: ${{ steps.configure.outputs.branch }}
      on_release_branch: ${{ steps.configure.outputs.on_release_branch }}
      commit_message: ${{ steps.configure.outputs.commit_message }}
      github_release: ${{ steps.configure.outputs.github_release }}
    steps:
      - name: Configure release
        id: configure
        uses: braintrustdata/sdk-actions/actions/release/lang/py/configure@<%= ref %>
        with:
          version_file: <%= version_file %>
          sha: ${{ inputs.sha }}
          working_directory: <%= working_directory %>
          release_type: ${{ inputs.release_type }}

  prepare:
    needs: configure
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    permissions:
      contents: write  # releases/generate-notes API
    outputs:
      pr_list: ${{ steps.prepare.outputs.pr_list }}
      notes: ${{ steps.prepare.outputs.notes }}
    steps:
      - name: Prepare release
        id: prepare
        uses: braintrustdata/sdk-actions/actions/release/prepare@<%= ref %>
        with:
          release_tag: ${{ needs.configure.outputs.release_tag }}
          sha: ${{ inputs.sha }}
          prev_release: ${{ inputs.prev_release || needs.configure.outputs.prev_release }}

  validate:
    needs: [configure, prepare]
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    permissions:
      contents: read
    steps:
      - name: Validate release
        uses: braintrustdata/sdk-actions/actions/release/lang/py/validate@<%= ref %>
        with:
          version: ${{ needs.configure.outputs.version }}
          sha: ${{ inputs.sha }}
          dry_run: ${{ inputs.dry_run }}
          working_directory: <%= working_directory %>
          python_version: <%= python_version %>
          package_name: <%= package_name %>
          release_tag: ${{ needs.configure.outputs.release_tag }}
          on_release_branch: ${{ needs.configure.outputs.on_release_branch }}
          notes: ${{ needs.prepare.outputs.notes }}

  request-approval:
    needs: [configure, prepare, validate]
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    permissions: {}
    steps:
      - name: Request release approval
        uses: braintrustdata/sdk-actions/actions/release/request-approval@<%= ref %>
        with:
          sha: ${{ inputs.sha }}
          release_tag: ${{ needs.configure.outputs.release_tag }}
          prev_release: ${{ needs.configure.outputs.prev_release }}
          branch: ${{ needs.configure.outputs.branch }}
          on_release_branch: ${{ needs.configure.outputs.on_release_branch }}
          commit_message: ${{ needs.configure.outputs.commit_message }}
          pr_list: ${{ needs.prepare.outputs.pr_list }}
          notes: ${{ needs.prepare.outputs.notes }}
          dry_run: ${{ inputs.dry_run }}
          slack_token: ${{ secrets.<%= slack_token_secret %> }}
          slack_channel: ${{ vars.<%= slack_channel_var %> }}
          label: <%= package_name %>
          emoji: '<%= emoji %>'

  build-and-ship:
    needs: [configure, prepare, validate, request-approval]
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    environment: ${{ inputs.dry_run && '<%= dry_run_environment %>' || '<%= publish_environment %>' }}
    permissions:
      contents: write
      id-token: write  # OIDC trusted publishing + PEP 740 attestations
      attestations: write  # signed SBOM attestation
    steps:
      - name: Build and ship
        uses: braintrustdata/sdk-actions/actions/release/lang/py/build-and-ship@<%= ref %>
        with:
          sha: ${{ inputs.sha }}
          working_directory: <%= working_directory %>
          python_version: <%= python_version %>
          dry_run: ${{ inputs.dry_run }}
          release_tag: ${{ needs.configure.outputs.release_tag }}
          github_release: ${{ needs.configure.outputs.github_release }}
          version: ${{ needs.configure.outputs.version }}
          package_name: <%= package_name %>
          label: <%= package_name %>
          notes: ${{ needs.prepare.outputs.notes }}
          prev_release: ${{ needs.configure.outputs.prev_release }}
          branch: ${{ needs.configure.outputs.branch }}
          on_release_branch: ${{ needs.configure.outputs.on_release_branch }}
          pr_list: ${{ needs.prepare.outputs.pr_list }}
          slack_token: ${{ secrets.<%= slack_token_secret %> }}
          slack_channel: ${{ vars.<%= slack_channel_var %> }}
          emoji: '<%= emoji %>'
