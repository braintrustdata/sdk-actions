<%#
  Generates a CycloneDX SBOM for the built distribution and writes it to
  <working_directory>/sbom.json using cyclonedx-py (OWASP CycloneDX, pinned), run
  ephemerally via uvx so it is never a project dependency. cyclonedx-py has no
  native uv-lockfile reader, so we install the just-built wheel into a throwaway
  venv and scan that environment for the wheel's resolved runtime closure.

  `cyclonedx-py environment` produces an ENV scan (no package subject, and it gives
  the local wheel no purl), so a jq post-step promotes the built package to the SBOM
  subject (metadata.component, type library) with a pkg:pypi purl, drops the local
  build-path externalReference, and removes it from the components list. The
  dependencies graph cyclonedx-py emits (rooted at the package's bom-ref) is left
  intact. The composing action gates this step with `if: inputs.sbom == 'true'` (it
  still runs on dry runs, so the SBOM is previewed; signing/upload are gated
  separately). Assumes lang/py/build produced <working_directory>/dist/*.whl.

  @param working_directory [String] expr for the package root. Default: ${{ inputs.working_directory }}
-%>
- name: Generate SBOM (CycloneDX)
  shell: bash
  working-directory: <%= locals.fetch(:working_directory) { "${{ inputs.working_directory }}" } %>
  run: |
    # cyclonedx-py can't read uv lockfiles, so scan the wheel's installed closure:
    # install the built wheel into a throwaway venv, then generate from that env.
    SBOM_VENV="$(mktemp -d)/venv"
    uv venv "$SBOM_VENV"
    uv pip install --python "$SBOM_VENV/bin/python" dist/*.whl
    # NB: do NOT add --output-reproducible — it strips serialNumber (and the timestamp),
    # and actions/attest requires serialNumber to recognize the SBOM as CycloneDX.
    uvx --from "cyclonedx-bom==7.3.0" cyclonedx-py environment "$SBOM_VENV" \
      --spec-version 1.7 --output-format JSON --output-file sbom.raw.json

    # Promote the built package to the SBOM subject: the env scan leaves it in
    # `components` with no purl and a local build-path ref. Identify it (the only
    # component installed from a local file://), set it as metadata.component with a
    # pkg:pypi purl (normalized: lowercase, '_'->'-'), strip the build-path ref, and
    # drop it from components. Its bom-ref (and the dependencies-graph root) are kept.
    jq '
      def is_local: (.externalReferences // []) | any(.type == "distribution" and ((.url // "") | tostring | startswith("file:")));
      ([.components[] | select(is_local)] | .[0]) as $subj
      | if $subj == null then error("SBOM: could not identify the built package component") else . end
      | ($subj.name | ascii_downcase | gsub("_"; "-")) as $norm
      | .metadata.component = (
          $subj
          | .type = "library"
          | .purl = "pkg:pypi/\($norm)@\($subj.version)"
          | .externalReferences = [ (.externalReferences // [])[] | select(((.url // "") | tostring | startswith("file:")) | not) ]
          | if (.externalReferences | length) == 0 then del(.externalReferences) else . end )
      | .components = [ .components[] | select(.["bom-ref"] != $subj["bom-ref"]) ]
    ' sbom.raw.json > sbom.json
    rm -f sbom.raw.json
    echo "Wrote $(pwd)/sbom.json"
