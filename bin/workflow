#!/usr/bin/env ruby
# frozen_string_literal: true
#
# sdk-actions release-workflow generator. Renders a clean, ready-to-commit release
# workflow into a consumer's repo from a parameterized template in templates/workflows/,
# and keeps it in sync with upstream via a provenance header + 3-way merge.
#
#   bin/workflow generate <template-id> [--<param> …] [--ref SHA] [--dest FILE] [--force]
#   bin/workflow compare  <file> [--ref SHA]     # diff the file against a freshly-rendered baseline
#   bin/workflow update   <file> [--ref SHA]     # merge upstream changes in (keeps your edits)
#   bin/workflow generate release/ruby/turnkey --help   # lists that template's params

require 'optparse'
require 'json'
require 'yaml'
require 'fileutils'
require 'tmpdir'
require_relative '../scripts/lib/template'

ROOT          = File.expand_path('..', __dir__)
WORKFLOWS_DIR = File.join(ROOT, 'templates', 'workflows')

def die(msg) = (warn("error: #{msg}"); exit(1))

def template_path(id)    = File.join(WORKFLOWS_DIR, "#{id}.yml.erb")
def template_relpath(id) = "templates/workflows/#{id}.yml.erb"
def version_relpath(id)  = "templates/workflows/#{id.split('/').first}/VERSION"

# The leading `<%# … -%>` block is YAML frontmatter: a `params:` schema (name ->
# {required|default, desc}) the CLI builds its flags from, and an optional `checklist:`
# (post-generate next-steps, with %{param} / %{workflow_file} placeholders). ERB renders
# the block to nothing.
def read_frontmatter(source)
  body = source[/\A<%#(.*?)-?%>/m, 1] or return {}
  YAML.safe_load(body) || {}
end

# Print the template's next-steps checklist, substituting %{param}/%{workflow_file}.
def print_checklist(checklist, params, dest)
  return if checklist.nil? || checklist.empty?
  vars = params.transform_keys(&:to_s).transform_values(&:to_s)
  vars['workflow_file'] = dest ? File.basename(dest) : 'your workflow file'
  warn "\nNext steps:"
  checklist.each_with_index do |line, i|
    warn "  #{i + 1}. " + line.gsub(/%\{(\w+)\}/) { vars[$1] || "%{#{$1}}" }
  end
end

# Nearest VERSION file walking up from the template toward templates/workflows/.
def family_version(path)
  dir = File.dirname(path)
  while dir.start_with?(WORKFLOWS_DIR)
    vf = File.join(dir, 'VERSION')
    return File.read(vf).strip if File.exist?(vf)
    break if dir == WORKFLOWS_DIR
    dir = File.dirname(dir)
  end
  nil
end

# The template / VERSION as they were at a given sdk-actions ref (nil if absent there).
def repo_show(ref, relpath)
  out = `git -C "#{ROOT}" show "#{ref}:#{relpath}" 2>/dev/null`
  $?.success? ? out : nil
end

def version_at(ref, id) = repo_show(ref, version_relpath(id))&.strip

def default_ref
  sha = `git -C "#{ROOT}" rev-parse origin/main 2>/dev/null`.strip
  sha.empty? ? nil : sha
end

# Provenance = one `# sdk-actions: {json}` comment (same convention as the actions),
# carrying what compare/update need to re-render the exact baseline. Read it back with:
#   sed -n 's/^# sdk-actions: //p' <file> | jq
def provenance_header(template_id, ref, params, version)
  meta = { 'template' => template_id, 'ref' => ref }
  meta['version'] = version if version
  meta['params'] = params.sort.to_h  # key-sorted: stable regardless of CLI flag order
  "# GENERATED by sdk-actions `bin/workflow` — update with: bin/workflow update <this file>\n" +
    Templating.metadata_comment(meta) + "\n"
end

def read_provenance(file)
  File.exist?(file) or die("no such file: #{file}")
  line = File.foreach(file).find { |l| l.start_with?('# sdk-actions: ') }
  line or die("no sdk-actions provenance in #{file} — was it generated by bin/workflow?")
  JSON.parse(line.sub(/^# sdk-actions: /, ''))
end

# Full rendered output (provenance header + workflow body) from a template SOURCE string.
def render_output(source, template_id, params, ref, version)
  body = Templating::Template.new(source).render(**params.transform_keys(&:to_sym), ref: ref)
  provenance_header(template_id, ref, params, version) + body
end

def cmd_generate(argv)
  id   = argv.shift or die('usage: bin/workflow generate <template-id> [options]')
  path = template_path(id)
  File.exist?(path) or die("no such template: #{id}")
  source    = File.read(path)
  fm        = read_frontmatter(source)
  schema    = fm['params'] || {}
  checklist = fm['checklist'] || []

  opts   = { ref: nil, dest: nil, force: false }
  params = {}
  parser = OptionParser.new do |o|
    o.banner = "usage: bin/workflow generate #{id} [options]"
    schema.each do |name, spec|
      spec ||= {}
      params[name] = spec['default'] if spec.key?('default')
      hint = spec['required'] ? ' (required)' : (spec.key?('default') ? " [#{spec['default'].inspect}]" : '')
      o.on("--#{name.tr('_', '-')} VALUE", "#{spec['desc']}#{hint}") { |v| params[name] = v }
    end
    o.separator ''
    o.on('--ref SHA',   'sdk-actions ref to pin actions to (default: origin/main)') { |v| opts[:ref] = v }
    o.on('--dest FILE', 'write to FILE (default: stdout)')                          { |v| opts[:dest] = v }
    o.on('--force',     'overwrite an existing --dest')                             { opts[:force] = true }
    o.on('-h', '--help') { puts o; exit(0) }
  end
  parser.parse!(argv)

  missing = schema.select { |n, s| (s || {})['required'] && params[n].to_s.empty? }.keys
  die("missing required: #{missing.map { |m| "--#{m.tr('_', '-')}" }.join(', ')}") unless missing.empty?

  ref    = opts[:ref] || default_ref or die('could not resolve origin/main; pass --ref SHA')
  output = render_output(source, id, params, ref, family_version(path))

  if (dest = opts[:dest])
    die("#{dest} exists (use --force to overwrite)") if File.exist?(dest) && !opts[:force]
    FileUtils.mkdir_p(File.dirname(dest))
    File.write(dest, output)
    warn "✓ wrote #{dest}  (sdk-actions @ #{ref[0, 10]})"
  else
    print output
  end
  print_checklist(checklist, params, opts[:dest])
end

def cmd_validate(argv)
  file = argv.shift or die('usage: bin/workflow validate <file>')
  File.exist?(file) or die("no such file: #{file}")
  begin
    YAML.safe_load_file(file, aliases: true)
  rescue Psych::SyntaxError => e
    die("#{file}:#{e.line}:#{e.column}: #{e.problem}")
  end
  on_path = ENV['PATH'].to_s.split(File::PATH_SEPARATOR).any? { |d| File.executable?(File.join(d, 'check-jsonschema')) }
  die('check-jsonschema not found on PATH — install the toolchain with `mise install` (or `pipx install check-jsonschema`)') unless on_path
  system('check-jsonschema', '--builtin-schema', 'vendor.github-workflows', file) or exit(1)
end

def cmd_compare(argv)
  opts = { ref: nil }
  OptionParser.new do |o|
    o.banner = 'usage: bin/workflow compare <file> [--ref SHA]'
    o.on('--ref SHA', "compare against this upstream ref (default: the file's recorded ref)") { |v| opts[:ref] = v }
    o.on('-h', '--help') { puts o; exit(0) }
  end.parse!(argv)
  file = argv.shift or die('usage: bin/workflow compare <file> [--ref SHA]')

  meta = read_provenance(file)
  id, params = meta['template'], meta['params']
  ref = opts[:ref] || meta['ref']
  source = repo_show(ref, template_relpath(id)) || (File.exist?(template_path(id)) ? File.read(template_path(id)) : die("template #{id} not found at #{ref[0, 10]}"))
  baseline = render_output(source, id, params, ref, version_at(ref, id) || family_version(template_path(id)))

  Dir.mktmpdir do |d|
    b = File.join(d, 'baseline.yml')
    File.write(b, baseline)
    system('git', '--no-pager', 'diff', '--no-index', '--', b, file) # exit 1 when they differ (expected)
  end
end

def cmd_update(argv)
  opts = { ref: nil }
  OptionParser.new do |o|
    o.banner = 'usage: bin/workflow update <file> [--ref SHA]'
    o.on('--ref SHA', 'new sdk-actions ref (default: origin/main)') { |v| opts[:ref] = v }
    o.on('-h', '--help') { puts o; exit(0) }
  end.parse!(argv)
  file = argv.shift or die('usage: bin/workflow update <file> [--ref SHA]')

  meta = read_provenance(file)
  id, params, old_ref = meta['template'], meta['params'], meta['ref']
  new_ref = opts[:ref] || default_ref or die('could not resolve origin/main; pass --ref SHA')
  rel     = template_relpath(id)
  src_a = repo_show(old_ref, rel) or die("template #{id} not found at old ref #{old_ref[0, 10]}")
  src_b = repo_show(new_ref, rel) or die("template #{id} not found at new ref #{new_ref[0, 10]}")

  base = render_output(src_a, id, params, old_ref, version_at(old_ref, id))  # common ancestor
  theirs = render_output(src_b, id, params, new_ref, version_at(new_ref, id)) # upstream

  Dir.mktmpdir do |d|
    fbase  = File.join(d, 'base');  File.write(fbase, base)
    ftheir = File.join(d, 'their'); File.write(ftheir, theirs)
    # Apply (base → upstream) onto <file> (= base + the consumer's edits), keeping their edits.
    system('git', 'merge-file', '-L', 'your workflow', '-L', 'sdk-actions (old)', '-L', 'sdk-actions (new)',
           file, fbase, ftheir)
    code = $?.exitstatus
    if code.zero?
      warn "✓ updated #{file} to sdk-actions @ #{new_ref[0, 10]}"
    elsif code.positive?
      warn "⚠ merged #{file} with #{code} conflict(s) — resolve the <<<<<<< markers, then commit"
    else
      die("merge failed for #{file}")
    end
  end
end

case ARGV.shift
when 'generate' then cmd_generate(ARGV)
when 'validate' then cmd_validate(ARGV)
when 'compare'  then cmd_compare(ARGV)
when 'update'   then cmd_update(ARGV)
when nil, '-h', '--help'
  puts <<~USAGE
    usage: bin/workflow <command> [options]
      generate <template-id>   render a consumer release workflow (try --help after the id)
      validate <file>          check a workflow against the GitHub workflow schema
      compare  <file>          diff a workflow against a freshly-rendered baseline
      update   <file>          merge upstream changes into a workflow (keeps your edits)
  USAGE
else
  die('unknown command')
end
